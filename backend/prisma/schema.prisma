generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  firstName       String        @default("") @db.VarChar(80)
  lastName        String        @default("") @db.VarChar(80)
  passwordHash    String        @db.VarChar(255)
  avatarData      Bytes?
  avatarMimeType  String?       @db.VarChar(32)
  avatarUpdatedAt DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  categories      Category[]
  transactions    Transaction[] @relation("TransactionOwner")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(100)
  type         CategoryType
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionCategory")

  @@unique([id, userId])
  @@unique([userId, type, name])
}

model Transaction {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  categoryId          String               @db.Uuid
  amount              Decimal              @db.Decimal(12, 2)
  description         String?              @db.VarChar(500)
  occurredAt          DateTime             @db.Timestamptz(6)
  recurrenceFrequency RecurrenceFrequency?
  nextOccurrenceAt    DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  user                User                 @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  category            Category             @relation("TransactionCategory", fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)

  @@index([userId, occurredAt])
  @@index([categoryId, userId])
}
