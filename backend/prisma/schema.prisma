generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(320)
  firstName       String        @default("") @db.VarChar(80)
  lastName        String        @default("") @db.VarChar(80)
  passwordHash    String        @db.VarChar(255)
  role            UserRole      @default(USER)
  isActive        Boolean       @default(true)
  avatarData      Bytes?
  avatarMimeType  String?       @db.VarChar(32)
  avatarUpdatedAt DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  categories      Category[]
  transactions    Transaction[] @relation("TransactionOwner")
}

model GlobalCategory {
  id                String       @id @default(uuid()) @db.Uuid
  name              String       @db.VarChar(40)
  type              CategoryType
  icon              String       @default("circle")
  color             String       @default("#4338ca") @db.VarChar(7)
  enabledForNewUsers Boolean     @default(true)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([type, name])
  @@index([type, enabledForNewUsers])
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String   @db.VarChar(60)
  targetId    String   @db.VarChar(100)
  details     Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([actorUserId, createdAt])
  @@index([targetId, createdAt])
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(100)
  type         CategoryType
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation("TransactionCategory")

  @@unique([id, userId])
  @@unique([userId, type, name])
}

model Transaction {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  categoryId          String               @db.Uuid
  amount              Decimal              @db.Decimal(12, 2)
  description         String?              @db.VarChar(500)
  occurredAt          DateTime             @db.Timestamptz(6)
  recurrenceFrequency RecurrenceFrequency?
  nextOccurrenceAt    DateTime?            @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  user                User                 @relation("TransactionOwner", fields: [userId], references: [id], onDelete: Cascade)
  category            Category             @relation("TransactionCategory", fields: [categoryId, userId], references: [id, userId], onDelete: NoAction)

  @@index([userId, occurredAt])
  @@index([categoryId, userId])
}
